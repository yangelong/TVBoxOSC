<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_400"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">

        <TextView
            android:id="@+id/pwdTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:singleLine="true"
            android:text="该栏目需要密码"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_26" />

        <TextView
            android:id="@+id/pwdValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_15"
            android:gravity="center"
            android:hint="● ● ● ●"
            android:minHeight="@dimen/vs_60"
            android:textColor="@color/dialog_text_primary"
            android:textColorHint="@color/dialog_text_hint"
            android:textSize="@dimen/ts_26" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/key1"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_70"
                android:layout_margin="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/key2"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_70"
                android:layout_margin="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/key3"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_70"
                android:layout_margin="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_26" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/key4"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_70"
                android:layout_margin="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/key5"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_70"
                android:layout_margin="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/key6"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_70"
                android:layout_margin="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_26" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/key7"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_70"
                android:layout_margin="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="7"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/key8"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_70"
                android:layout_margin="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="8"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/key9"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_70"
                android:layout_margin="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="9"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_26" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/keyClear"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_70"
                android:layout_margin="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="清空"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/key0"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_70"
                android:layout_margin="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/keyOk"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_70"
                android:layout_margin="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="确定"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
