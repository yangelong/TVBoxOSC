<?xml version="1.0" encoding="utf-8"?>
<!-- 「换片源」那个固定按钮：背景常亮，用来和普通分类区分 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="20mm"/>
            <solid android:color="@color/color_BD0CADE2"/>
            <stroke android:width="1dp" android:color="@color/color_FFFFFF"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="20mm"/>
            <solid android:color="@color/color_4D0CADE2"/>
            <stroke android:width="1dp" android:color="@color/color_330CADE2"/>
        </shape>
    </item>
</selector>
