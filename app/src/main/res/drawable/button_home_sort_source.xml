<?xml version="1.0" encoding="utf-8"?>
<!-- 「换片源」那个固定按钮：背景常亮，而且必须是不透明实色（半透明时后面的栏目文字会透上来，看不清） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="20mm"/>
            <solid android:color="@color/color_0CADE2"/>
            <stroke android:width="1dp" android:color="@color/color_FFFFFF"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="20mm"/>
            <solid android:color="@color/color_0B4B64"/>
            <stroke android:width="1dp" android:color="@color/color_0CADE2"/>
        </shape>
    </item>
</selector>
